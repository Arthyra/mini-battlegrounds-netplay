!/lan-room-ui.cs
!/lan-scoreboard.cs
!/lan-launcher.cs
!/updater.cs
!/fullscreen-helper.cs
!/prepare_lan_client.py
!/build-friend-zip.py
!/build-release.py
!/tests/
/tests/*
!/tests/run-all.py
!/tests/test-public-battle.py
!/tests/test-connection-lifecycle.py
!/tests/test-room-and-explosion.py
!/tests/test-gameplay-timing.py
!/tests/test-discovery-endpoints.cs
!/tests/test-tcp-fin.cs
!/tests/test-battle-connect.cs
!/tests/test-update-policy.cs
!/tests/test-reconnect-state.cs
!/tests/test-updater-install.cs
!/tests/test-launcher-version.cs
!/tools/
/tools/*
!/tools/build-acceptance.py
!/tools/ecs-isolated-server.py
!/tools/ecs-acceptance-runner.cs
!/tools/ecs-network-fault.cs
!/tools/Start-EcsAcceptance.ps1
!/tools/Collect-EcsEvidence.ps1
!/tools/Invoke-EcsNetworkFault.ps1
!/tools/prune-update-mirror.sh
!/tools/check-build-inputs.py
!/tools/rebuild-client-dlls.py
!/tools/ilcheck.cs
!/tools/*.exe
!/build/
/build/*
