# Tracked source/document allowlist. Game files, generated builds and local test evidence remain ignored.
# NOTE: new source/doc files are NOT tracked until re-included here - always check `git status`.
/*
!/.gitignore
!/.github/
!/AGENTS.md
!/README.md
!/admin_server.py
!/server.py
!/lan_share.py
!/prepare-lan-client.py
!/patch-lan-combat.cs
!/patch-local-login.py
